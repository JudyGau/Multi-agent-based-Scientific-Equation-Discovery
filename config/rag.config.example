{
  "_comment": [
    "端点统一用 api_base_url（旧拼写 api_host 已废弃，写了会直接报错并提示改名）。"
  ],
  "backend": "api",
  "api_base_url": "https://api.siliconflow.cn/v1",
  "api_key": "",
  "api_model": "BAAI/bge-m3",
  "embed_batch_size": 32,
  "embed_max_retries": 8,
  "embed_backoff_base": 2.0,
  "embed_batch_interval": 0.5,
  "embed_file_interval": 1.0,
  "default_query": "磁流变 颗粒 本构"
}
